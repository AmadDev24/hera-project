# Gemini API Key for client-side grounded search
# IMPORTANT: Restrict this key by HTTP referrer in Google Cloud Console:
#   Go to: console.cloud.google.com → APIs & Services → Credentials
#   Application restrictions → HTTP referrers → Add:
#     hernancres-chatbot.web.app/*
#     localhost:5173/*
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Resend API Key for admin email alerts
# Get your key at: https://resend.com/api-keys
# IMPORTANT: Restrict by domain in Resend dashboard
VITE_RESEND_API_KEY=your-resend-api-key-here
