rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global deny-all safety net ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Auth helpers ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "syamiel2410@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ── Schema helpers ────────────────────────────────────────────────────

    // Conversations: required core fields only — allow extra fields (requiresHelp, source, etc.)
    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt', 'messages'])
          && data.id is string && data.id.size() <= 128
          && data.userId is string && data.userId.size() <= 256
          && data.title is string && data.title.size() <= 256
          && data.messages is list
          && (data.createdAt is string || data.createdAt is timestamp)
          && (data.updatedAt is string || data.updatedAt is timestamp);
    }

    function isValidAnalytics(data) {
      return data.keys().hasAll(['id', 'query', 'timestamp', 'domainCount', 'citedDomains', 'clientEmail'])
          && data.id is string && data.id.size() <= 128
          && data.query is string && data.query.size() <= 2000
          && data.domainCount is int
          && data.citedDomains is list
          && data.clientEmail is string && data.clientEmail.size() <= 256
          && (data.timestamp is string || data.timestamp is timestamp);
    }

    function isValidFAQ(data) {
      return data.keys().hasAll(['id', 'title', 'query', 'answer', 'order', 'enabled'])
          && data.id is string && data.id.size() <= 128
          && data.title is string && data.title.size() <= 256
          && data.query is string && data.query.size() <= 2000
          && data.answer is string && data.answer.size() <= 5000
          && data.order is int
          && data.enabled is bool;
    }

    // Leads: either email or phone must be present (phone-only leads now supported)
    function isValidLead(data) {
      return data.keys().hasAll(['id', 'firstQuery', 'timestamp', 'source'])
          && data.id is string && data.id.size() <= 128
          && data.firstQuery is string && data.firstQuery.size() <= 2000
          && data.source is string
          && (data.timestamp is string || data.timestamp is timestamp)
          && (
            (data.keys().hasAny(['email']) && data.email is string && data.email.size() <= 256) ||
            (data.keys().hasAny(['phone']) && data.phone is string && data.phone.size() <= 50)
          );
    }

    // ── Collection rules ──────────────────────────────────────────────────

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Conversations — embed widget uses device UUID as userId (not 'embed-widget' anymore)
    match /conversations/{conversationId} {
      allow read, list: if true;

      // Authenticated users (admin playground)
      allow create: if isSignedIn()
                    && isValidId(conversationId)
                    && isValidConversation(incoming());

      allow update: if isSignedIn()
                    && isValidId(conversationId)
                    && isValidConversation(incoming())
                    && incoming().createdAt == existing().createdAt;

      // Embed widget — unauthenticated create (any userId is allowed)
      allow create: if !isSignedIn()
                    && isValidId(conversationId)
                    && incoming().keys().hasAll(['id', 'userId', 'title', 'messages', 'createdAt', 'updatedAt'])
                    && incoming().userId is string
                    && incoming().title is string
                    && incoming().messages is list;

      // Embed widget — unauthenticated update (for streaming chunks and requiresHelp flag)
      allow update: if !isSignedIn()
                    && isValidId(conversationId)
                    && incoming().userId is string;

      allow delete: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow create: if isSignedIn()
                    && isValidId(analyticsId)
                    && isValidAnalytics(incoming());

      allow create: if !isSignedIn()
                    && isValidId(analyticsId)
                    && incoming().keys().hasAll(['id', 'query', 'timestamp', 'domainCount', 'citedDomains', 'clientEmail'])
                    && incoming().query is string
                    && incoming().clientEmail is string
                    && incoming().citedDomains is list
                    && incoming().domainCount is int;

      allow get, list: if true;
      allow update, delete: if false;
    }

    match /faqs/{faqId} {
      allow read, list: if true;
      allow create, update: if isValidId(faqId) && isValidFAQ(incoming());
      allow delete: if true;
    }

    // Leads — supports deduplication overwrites and phone-only leads
    match /leads/{leadId} {
      allow read, list: if true;

      // Create new lead (email or phone)
      allow create: if isValidId(leadId) && isValidLead(incoming());

      // Overwrite/update existing lead for deduplication (same contact, new session)
      allow update: if isValidId(leadId) && isValidLead(incoming());

      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /audit/{auditId} {
      allow read, list: if true;
      allow create: if incoming().keys().hasAll(['id', 'action', 'detail', 'adminEmail', 'timestamp'])
                    && incoming().action is string;
      allow update, delete: if false;
    }

    // Allowed users (admin access list)
    match /allowedUsers/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSignedIn()
                            && incoming().keys().hasAll(['id', 'email', 'addedAt'])
                            && incoming().email is string
                            && incoming().email.size() <= 256;
      allow delete: if isSignedIn();
    }

    // User profiles (persistent client preferences from embed chat)
    match /userProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId)
                            && incoming().keys().hasAll(['userId', 'savedAt'])
                            && incoming().userId is string;
      allow delete: if isAdmin();
    }

  }
}